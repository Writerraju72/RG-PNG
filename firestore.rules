rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    // Validation Blueprint: UserProfile (/users/{userId})
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'handle', 'bio', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'handle', 'bio', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 40 && data.handle.matches('^[a-zA-Z0-9_\\-]+$')
        && data.bio is string && data.bio.size() <= 200
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: CommunityUpload (/uploads/{uploadId})
    function isValidCommunityUpload(data, uploadId) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'name', 'format',
          'dataUrl', 'width', 'height', 'tags',
          'likesCount', 'sharesCount', 'visibility', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'name', 'format',
          'dataUrl', 'width', 'height', 'tags',
          'likesCount', 'sharesCount', 'visibility', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.id == uploadId
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.format is string && data.format.size() == 3 && (data.format == 'PNG' || data.format == 'JPG')
        && data.dataUrl is string && data.dataUrl.size() >= 20 && data.dataUrl.size() <= 650000
        && data.width is int && data.width >= 1 && data.width <= 2048
        && data.height is int && data.height >= 1 && data.height <= 2048
        && data.tags is list && data.tags.size() <= 10
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() >= 1 && data.tags[0].size() <= 30))
        && data.likesCount is int && data.likesCount >= 0
        && data.sharesCount is int && data.sharesCount >= 0
        && data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: AssetStat (/assetStats/{assetId})
    function isValidAssetStat(data, assetId) {
      return data.keys().hasAll(['assetId', 'likesCount', 'sharesCount', 'visibility', 'updatedAt'])
        && data.keys().hasOnly(['assetId', 'likesCount', 'sharesCount', 'visibility', 'updatedAt'])
        && data.assetId is string && data.assetId.size() >= 1 && data.assetId.size() <= 128 && data.assetId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.assetId == assetId
        && data.likesCount is int && data.likesCount >= 0
        && data.sharesCount is int && data.sharesCount >= 0
        && data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public'
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: AssetLike (/assetStats/{assetId}/likes/{userId})
    function isValidAssetLike(data, assetId, userId) {
      return data.keys().hasAll(['assetId', 'userId', 'createdAt'])
        && data.keys().hasOnly(['assetId', 'userId', 'createdAt'])
        && data.assetId is string && data.assetId.size() >= 1 && data.assetId.size() <= 128 && data.assetId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.assetId == assetId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.createdAt is timestamp;
    }

    // Collection 1: Public Creator Profiles (/users/{userId})
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'handle', 'bio', 'photoURL', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Collection 2: Community PNG/JPG Uploads (/uploads/{uploadId})
    match /uploads/{uploadId} {
      allow get: if isValidId(uploadId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';

      allow create: if isVerifiedUser()
        && isValidId(uploadId)
        && isValidCommunityUpload(incoming(), uploadId)
        && incoming().authorId == request.auth.uid
        && incoming().likesCount == 0
        && incoming().sharesCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser()
        && isValidId(uploadId)
        && isValidCommunityUpload(incoming(), uploadId)
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner edits caption/tags
          (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'tags', 'updatedAt'])
          )
          ||
          // Action 2: Community increments/decrements likesCount or sharesCount by at most 1
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'sharesCount', 'updatedAt'])
            && incoming().likesCount >= existing().likesCount - 1
            && incoming().likesCount <= existing().likesCount + 1
            && incoming().sharesCount >= existing().sharesCount
            && incoming().sharesCount <= existing().sharesCount + 1
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(uploadId)
        && existing().authorId == request.auth.uid;
    }

    // Collection 3: Public Asset Stats (/assetStats/{assetId})
    match /assetStats/{assetId} {
      allow get: if isValidId(assetId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';

      allow create: if isVerifiedUser()
        && isValidId(assetId)
        && isValidAssetStat(incoming(), assetId)
        && incoming().likesCount <= 1
        && incoming().sharesCount <= 1
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(assetId)
        && isValidAssetStat(incoming(), assetId)
        && incoming().assetId == existing().assetId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'sharesCount', 'updatedAt'])
        && incoming().likesCount >= existing().likesCount - 1
        && incoming().likesCount <= existing().likesCount + 1
        && incoming().sharesCount >= existing().sharesCount
        && incoming().sharesCount <= existing().sharesCount + 1;

      allow delete: if false;

      // Subcollection: Per-user Like Receipts (/assetStats/{assetId}/likes/{userId})
      match /likes/{userId} {
        allow get: if isOwner(userId) && isValidId(assetId) && isValidId(userId);
        allow list: if isVerifiedUser() && existing().userId == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(assetId)
          && isValidId(userId)
          && isValidAssetLike(incoming(), assetId, userId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/assetStats/$(assetId));

        allow update: if false;

        allow delete: if isOwner(userId)
          && isValidId(assetId)
          && isValidId(userId)
          && exists(/databases/$(database)/documents/assetStats/$(assetId));
      }
    }
  }
}
